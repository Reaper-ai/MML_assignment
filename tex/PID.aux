\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Target step $1 \to 2$\,m at $t=3$\,s ($K_p=100, K_i=50, K_d=10$). Differentiating on PV cuts the peak control spike from $1120.1$\,N to $120.1$\,N.}}{8}{}\protected@file@percent }
\newlabel{fig:kick}{{9}{8}{}{}{}}
