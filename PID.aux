\@writefile{toc}{\contentsline {section}{\numberline {5}Real-world Problems}{8}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}(a) Integral windup}{8}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The problem.}{8}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The fix: clamping (conditional integration).}{8}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Windup ($K_p=40$, $K_i=200$, $K_d=0$, force limit $\pm 30$\,N): position, force and integral term. The integral grows during saturation and the block overshoots the 1\,m target to 1.353\,m (35.3\%).}}{9}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}(b) Sensor noise and the derivative term}{9}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The problem.}{9}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Same gains with clamping. The integral stops growing while the force is at 30\,N, and the overshoot falls from 35.3\% to 7.1\% (peak 1.353\,m $\to $ 1.071\,m). The peak integral force falls from 57\,N to 23\,N.}}{9}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The fix: low-pass filter on the derivative.}{10}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Force noise in steady state with $\pm 1$\,mm sensor noise ($K_p=100$, $K_i=50$, $\Delta t=0.01$\,s, fixed random seed). The filter cuts the noise by 85--93\%.}}{10}{}\protected@file@percent }
\newlabel{tab:noise}{{5}{10}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}(c) Derivative kick}{10}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The problem.}{10}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The fix: differentiate the measurement, not the error.}{10}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Target stepped from 1\,m to 2\,m at $t=3$\,s ($K_p=100$, $K_i=50$, $K_d=10$, $\Delta t=0.01$\,s). Left: D on error, with a force spike of about 1100\,N. Right: D on measurement. The spike falls to about 120\,N, which is only the P jump ($K_p\Delta r=100$\,N) plus the existing holding force.}}{10}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}(d) Slow computer update}{11}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The problem.}{11}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Effect of the controller update time ($K_p=100$, $K_i=50$, $K_d=10$).}}{11}{}\protected@file@percent }
\newlabel{tab:ts}{{6}{11}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Step responses for $T_s = 1, 10, 100, 200, 300$\,ms. Up to 100\,ms the curves are almost identical, then overshoot appears and at 300\,ms the output diverges.}}{11}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The fix.}{11}{}\protected@file@percent }
