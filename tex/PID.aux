\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Integral windup vs.\ conditional integration anti-windup ($\pm 30$\,N actuator limit, $K_p=100, K_i=120, K_d=10$). Overshoot drops from $10.2\%$ to $0.0\%$.}}{7}{}\protected@file@percent }
\newlabel{fig:windup}{{7}{7}{}{}{}}
