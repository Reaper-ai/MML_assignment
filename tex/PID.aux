\@writefile{toc}{\contentsline {paragraph}{The problem.}{7}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The fix: first-order low-pass filter on D.}{7}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {7.3}(c) Derivative kick}{7}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The problem.}{7}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Effect of $\pm 1$\,mm sensor noise with $K_d=50$. Filtering the derivative ($\alpha =0.1$) suppresses steady-state control chatter, reducing overall control standard deviation from $10.12$\,N to $7.56$\,N.}}{8}{}\protected@file@percent }
\newlabel{fig:noise}{{8}{8}{}{}{}}
